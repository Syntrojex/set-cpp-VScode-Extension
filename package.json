{
  "name": "setify-cpp",
  "displayName": "Setify C++ — C++ Setup for VS Code",
  "description": "Zero-config C++ development for VS Code on Windows — automatically detects or installs MinGW-w64 and configures everything for you.",
  "version": "1.0.2",
  "publisher": "Syntrojex",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages", "Other"],
  "keywords": [
    "setify-cpp",
    "setify",
    "c++",
    "cpp",
    "c-plus-plus",
    "mingw",
    "mingw-w64",
    "g++",
    "gcc",
    "compiler",
    "cpp-development",
    "vscode",
    "windows",
    "setup",
    "run",
    "beginner"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "extensionDependencies": ["ms-vscode.cpptools"],
  "contributes": {
    "commands": [
      {
        "command": "setify-cpp.setup",
        "title": "Setup C++ Compiler (runs automatically on install)",
        "category": "Setify C++"
      },
      {
        "command": "setify-cpp.runActiveFile",
        "title": "Run Active C++ File",
        "category": "Setify C++"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx",
          "command": "setify-cpp.runActiveFile",
          "group": "navigation"
        }
      ],
      "editor/title/run": [
        {
          "when": "resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx",
          "command": "setify-cpp.runActiveFile",
          "group": "navigation"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Syntrojex/seify-cpp-vscode.git"
  },
  "author": {
    "name": "Muhammad Mustafa Amir",
    "url": "https://github.com/Syntrojex"
  },
  "license": "MIT"
}
