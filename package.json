{
  "name": "set-cpp",
  "displayName": "Set C++ — C++ Setup for VS Code",
  "description": "Zero-config C++ development for VS Code on Windows — automatically detects or installs MinGW-w64 and configures everything for you.",
  "version": "1.0.0",
  "publisher": "Syntrojex",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "c++",
    "cpp",
    "c-plus-plus",
    "mingw",
    "mingw-w64",
    "g++",
    "gcc",
    "compiler",
    "cpp-development",
    "vscode",
    "windows",
    "setup",
    "run",
    "beginner"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "extensionDependencies": [
    "ms-vscode.cpptools"
  ],
  "contributes": {
    "commands": [
      {
        "command": "set-cpp.setup",
        "title": "Setup C++ Compiler (runs automatically on install)",
        "category": "set-cpp"
      },
      {
        "command": "set-cpp.runActiveFile",
        "title": "Run Active C++ File",
        "category": "set-cpp"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx",
          "command": "set-cpp.runActiveFile",
          "group": "navigation"
        }
      ],
      "editor/title/run": [
        {
          "when": "resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx",
          "command": "set-cpp.runActiveFile",
          "group": "navigation"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Syntrojex/set-cpp-vscode.git"
  },
  "author": {
    "name": "Muhammad Mustafa Amir",
    "url": "https://github.com/Syntrojex"
  },
  "license": "MIT"
}
